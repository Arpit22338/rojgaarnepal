# Required for all text-generation features.
OPENROUTER_API_KEY=

# Optional. Defaults to the automatic free-model router.
# Use openrouter/auto for quality-based routing that may incur usage charges.
OPENROUTER_MODEL=openrouter/free

# Datadog RUM (create these in the Datadog US5 organization).
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
DD_SITE=us5.datadoghq.com
